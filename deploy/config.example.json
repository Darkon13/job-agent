{
  "schema_version": 1,
  "database": {
    "driver": "sqlite",
    "path": "/data/job-agent.db"
  },
  "server": {
    "listen": "0.0.0.0:8080",
    "exposure": "private",
    "follow_up_reconcile_interval": "30s",
    "scheduler_reconcile_interval": "30s"
  },
  "adapters": [
    {
      "tag": "hh-main",
      "type": "hh",
      "settings": {
        "api_delay_ms": 350,
        "user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36"
      }
    }
  ],
  "profile_store": {
    "dir": "/data/profile-store"
  },
  "profiles": [
    {
      "tag": "main",
      "adapter": "hh-main",
      "resumes": [
        {
          "id": "replace-with-hh-resume-id",
          "primary": true
        }
      ],
      "state_file": "/data/profiles/main.json",
      "applications": {
        "mode": "dry_run",
        "message_template_file": "messages/backend.json",
        "qualification": {
          "include_any": [
            "Go",
            "Golang",
            "Backend"
          ],
          "exclude_any": [
            "руководитель",
            "team lead",
            "tech lead"
          ]
        },
        "timezone": "Europe/Moscow"
      },
      "conversations": {
        "allow_send": false,
        "allow_mark_read": false
      },
      "enabled": true
    }
  ],
  "searches": [
    {
      "tag": "golang-global",
      "adapter": "hh-main",
      "profiles": [
        "main"
      ],
      "priority": 100,
      "target_applications": 20,
      "fallback": "golang-similar",
      "query": {
        "source": "global",
        "text": "Golang developer",
        "area": [
          "1"
        ],
        "order_by": "publication_time",
        "period": 7,
        "page_size": 20,
        "max_pages": 2
      }
    },
    {
      "tag": "golang-similar",
      "adapter": "hh-main",
      "profiles": [
        "main"
      ],
      "priority": 50,
      "target_applications": 10,
      "query": {
        "source": "similar_resume",
        "resume": "$profile",
        "area": [
          "1"
        ],
        "page_size": 20,
        "max_pages": 1
      }
    }
  ],
  "jobs": [
    {
      "tag": "daily-applications",
      "enabled": true,
      "priority": 100,
      "concurrency": "forbid",
      "triggers": [
        {
          "type": "cron",
          "expression": "30 9 * * *"
        }
      ],
      "action": {
        "type": "application.campaign",
        "profiles": [
          "main"
        ],
        "routes": [
          "golang-global",
          "golang-similar"
        ],
        "target_successful": 20,
        "max_in_flight": 2
      }
    }
  ]
}
