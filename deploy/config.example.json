{
  "database": {
    "driver": "sqlite",
    "path": "/data/job-agent.db"
  },
  "server": {
    "listen": "0.0.0.0:8080",
    "exposure": "private",
    "follow_up_reconcile_interval": "30s",
    "scheduler_reconcile_interval": "30s"
  },
  "adapters": [
    {
      "tag": "hh-main",
      "type": "hh",
      "settings": {
        "api_delay_ms": 350,
        "user_agent": "JobAgent/0.1 (replace-with-contact-email)"
      }
    }
  ],
  "profiles": [],
  "jobs": [],
  "searches": []
}
