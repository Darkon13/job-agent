# Copy to .env and adjust. Compose reads this file automatically.
#
# Prebuilt image (recommended for releases). Keep the tag in sync with the
# release you downloaded, or point it at a locally built image such as
# job-agent:local.
JOB_AGENT_IMAGE=ghcr.io/darkon13/job-agent:latest
JOB_AGENT_VERSION=latest

# Runtime identity used for mounted volumes.
JOB_AGENT_UID=1000
JOB_AGENT_GID=100

# Configuration and persistent data.
JOB_AGENT_CONFIG_DIR=./deploy
JOB_AGENT_DATA_DIR=./data
JOB_AGENT_CONFIG_NAME=config.example.json

# Secrets. BROWSER_WORKER_TOKEN protects the Playwright service and must be a
# long random string; the browser worker refuses to start without it.
# Generate a value with: openssl rand -hex 32
BROWSER_WORKER_TOKEN=change-me
# Same for the API token when the CLI or a published API needs it.
JOB_AGENT_API_TOKEN=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Dashboard binding. Keep loopback unless the host is reachable only through a
# private network such as the AmneziaWG subnet.
JOB_AGENT_DASHBOARD_BIND_IP=127.0.0.1
JOB_AGENT_DASHBOARD_PORT=8081
JOB_AGENT_DASHBOARD_LISTEN=0.0.0.0:8081
