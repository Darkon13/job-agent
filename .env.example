# Copy to .env and adjust. Compose reads this file automatically.
#
# Prebuilt image (recommended for releases). Keep the tag in sync with the
# release you downloaded, or point it at a locally built image such as
# job-agent:local.
JOB_AGENT_IMAGE=ghcr.io/darkon13/job-agent:latest
JOB_AGENT_VERSION=latest

# Runtime identity used for mounted volumes.
JOB_AGENT_UID=1000
JOB_AGENT_GID=100

# Configuration and persistent data. Copy deploy/config.example.json to
# deploy/config.json first: the stack runs exactly this file.
JOB_AGENT_CONFIG_DIR=./deploy
JOB_AGENT_DATA_DIR=./data
JOB_AGENT_CONFIG_NAME=config.json

# Bridge MTU for the compose network. Keep 1500 on a plain connection; behind a
# VPN with a smaller tunnel MTU (AmneziaWG — 1280) set the same value here,
# otherwise containers lose large TLS handshakes (hh.ru) while the host works.
JOB_AGENT_NETWORK_MTU=1500

# Назначение и обязательность секретов.
# BROWSER_WORKER_TOKEN — общий секрет backend'а и browser-worker: воркер
# управляет Chromium с вашими авторизованными сессиями, поэтому каждый RPC
# подписан токеном. Нужен только с профилем browser (--profile browser).
# JOB_AGENT_API_TOKEN — Bearer-токен HTTP API; нужен, когда API/dashboard
# открыты не только с loopback, и для CLI auth/review/qualification.
# Ключи моделей — для model-операторов, только если в конфиге есть models.
# Сгенерировать значение: openssl rand -hex 32
BROWSER_WORKER_TOKEN=change-me
JOB_AGENT_API_TOKEN=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Dashboard binding. Keep loopback unless the host is reachable only through a
# private network such as the AmneziaWG subnet.
JOB_AGENT_DASHBOARD_BIND_IP=127.0.0.1
JOB_AGENT_DASHBOARD_PORT=8081
JOB_AGENT_DASHBOARD_LISTEN=0.0.0.0:8081
