# Packages locally built static binaries into the distroless runtime image.
# Useful on hosts where building Go inside Docker cannot reach the module
# proxy or has too little CPU/disk.
FROM gcr.io/distroless/static-debian12:nonroot AS runtime
WORKDIR /
ARG VERSION=1.8.3
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
LABEL org.opencontainers.image.title="Job Agent" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      org.opencontainers.image.source="https://github.com/Darkon13/job-agent"
COPY dist/job-agent /usr/local/bin/job-agent
COPY dist/job-agent-migrate /usr/local/bin/job-agent-migrate
COPY dist/job-agent-dashboard /usr/local/bin/job-agent-dashboard
